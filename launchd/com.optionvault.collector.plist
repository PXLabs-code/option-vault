<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.optionvault.collector</string>
  <key>UserName</key><string>YOUR_MAC_USERNAME</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>/ABSOLUTE/PATH/option-vault/scripts/launchd-run.sh</string>
    <string>/ABSOLUTE/PATH/option-vault/config.local.json</string>
  </array>
  <key>WorkingDirectory</key><string>/ABSOLUTE/PATH/option-vault</string>
  <key>RunAtLoad</key><true/>
  <key>StartInterval</key><integer>60</integer>
  <key>ProcessType</key><string>Background</string>
</dict>
</plist>
